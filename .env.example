SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,https://*.onrender.com

# Render/Postgres production database. Leave empty locally if using the DB_* MySQL settings below.
DATABASE_URL=
DB_CONN_MAX_AGE=600

# Local/development MySQL fallback.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

MEDIA_ROOT=
CLOUDINARY_URL=
PLATFORM_FEE=1000
MAX_IMAGE_UPLOAD_MB=2
PRODUCT_IMAGE_MAX_WIDTH=1200
PRODUCT_IMAGE_MAX_HEIGHT=1200
PRODUCT_IMAGE_QUALITY=82
PRODUCTS_PER_PAGE=12
SELLER_OTP_ENABLED=False

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend email API for production email on Render Free.
# Use onboarding@resend.dev for initial testing, then verify your domain in Resend
# and use an address on your own domain for real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ARUMarket <onboarding@resend.dev>

# In production, Django defaults to the Resend HTTP API backend so Render Free
# does not need SMTP access. Set this only if you intentionally want another backend.
# EMAIL_BACKEND=accounts.email_backends.ResendEmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Use your real mailbox username here if you choose SMTP instead of Resend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
# For Gmail, use a 16-character Google App Password, not your normal password.
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=5
DEFAULT_FROM_EMAIL=your-email@gmail.com
